# URL da API (backend Express). Em produção, aponte para a URL do Render.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Publisher ID do Google AdSense (formato ca-pub-XXXXXXXXXXXXXXXX), depois
# de criar a conta em adsense.google.com e ela ser aprovada. Enquanto essa
# variável não existir, nenhum script de anúncio é carregado (no-op).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
