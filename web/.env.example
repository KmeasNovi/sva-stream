# URL da API (backend Express). Em produção, aponte para a URL do Render.
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL do serviço Python de busca de filmes (scraper/), usado na aba "Buscar
# filmes" do /admin. É um serviço Render separado do backend acima — ver
# scraper/DEPLOY.md pra como publicar. Enquanto vazia, a aba mostra um aviso
# em vez de tentar chamar uma URL inexistente.
NEXT_PUBLIC_SCRAPER_API_URL=http://localhost:5055

# Client ID do OAuth do Google, para o botão "Entrar com Google". Precisa ser
# o mesmo valor de GOOGLE_CLIENT_ID no backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Publisher ID do Google AdSense (formato ca-pub-XXXXXXXXXXXXXXXX), depois
# de criar a conta em adsense.google.com e ela ser aprovada. Enquanto essa
# variável não existir, nenhum script de anúncio é carregado (no-op).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# IDs dos blocos de anúncio manual (AdSense > Anúncios > Por unidade de
# anúncio > criar) na página de filme — um antes do player, um abaixo do
# player, e outro entre a sinopse e "Mais como este". Enquanto vazios, esses
# espaços não aparecem (no-op), mesmo com NEXT_PUBLIC_ADSENSE_CLIENT_ID
# configurado.
NEXT_PUBLIC_ADSENSE_SLOT_MOVIE_ABOVE_PLAYER=
NEXT_PUBLIC_ADSENSE_SLOT_MOVIE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MOVIE_MID=

# Anúncio exibido por cima do player antes de liberar o filme (tipo pré-roll
# do YouTube, mas com imagem/banner em vez de vídeo — ver comentário no
# Player.jsx sobre por que um vídeo publicitário de verdade não é viável com
# o player embutido de terceiro). Enquanto vazio, o player libera na hora.
NEXT_PUBLIC_ADSENSE_SLOT_MOVIE_PREROLL=

# Mesma ideia, um bloco cada: página /catalogo (lista o catálogo inteiro) e
# /genre/[genre] (cada coleção temática). Ambas exigem login — o bloco só é
# renderizado depois que os filmes de verdade carregam, nunca na tela de
# carregamento, então não reabre o problema corrigido antes.
NEXT_PUBLIC_ADSENSE_SLOT_CATALOGO=
NEXT_PUBLIC_ADSENSE_SLOT_GENRE=

# Landing page (/) — entre a grade "Alguns clássicos do catálogo" e o CTA
# final. Tem conteúdo real (texto + 30 filmes com link), então é seguro por
# política mesmo sem exigir login.
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=

# /home (tela logada com as fileiras de filmes) — entre as fileiras fixas
# ("Em destaque"/"Adicionados recentemente") e a lista de gêneros.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# Adsterra (segunda rede de anúncios, empilhada junto com o AdSense nos
# mesmos espaços acima — nunca substitui, ver AdsterraBanner.jsx e
# AdsterraNativeBanner.jsx). Cada zona é criada em publishers.adsterra.com >
# Websites > sepiastream.com > Ad unit > Get code. Enquanto vazias, é no-op,
# mesmo padrão do AdSense acima. Só Banner e Native Banner são usados de
# propósito — Popunder/Smartlink/Social Bar arriscam a elegibilidade da
# conta AdSense (política do Google proíbe pop-up/pop-under em sites que
# também rodam AdSense, mesmo vindo de outra rede).
# Banner 728x90 — acima do player, no topo do filme, e na landing page.
NEXT_PUBLIC_ADSTERRA_BANNER_728X90_KEY=
# Banner 300x250 — catálogo, página de gênero, e pré-roll do player.
NEXT_PUBLIC_ADSTERRA_BANNER_300X250_KEY=
# Native Banner — zona única, usada no meio da página de filme (entre a
# sinopse e "Mais como este"), onde o formato nativo se mistura ao conteúdo.
NEXT_PUBLIC_ADSTERRA_NATIVE_SCRIPT_SRC=
NEXT_PUBLIC_ADSTERRA_NATIVE_CONTAINER_ID=

# Segredo compartilhado com o backend (mesmo valor de REVALIDATE_SECRET lá)
# — SEM o prefixo NEXT_PUBLIC_ de propósito, pra nunca ir pro bundle do
# navegador. Usado só pela rota /api/revalidate pra confirmar que quem está
# pedindo pra limpar o cache de um filme é o nosso próprio backend.
REVALIDATE_SECRET=
