# MongoDB Atlas — connection string do cluster free tier
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.mongodb.net/sva-stream

# Porta local (Render define isso sozinho em produção)
PORT=4000

# Segredo para assinar os tokens JWT (admin e usuários) — gere algo aleatório e longo
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Domínios que podem chamar a API (separe por vírgula). Use * apenas em dev.
CORS_ORIGIN=http://localhost:3000

# URL pública do site (Vercel) — usada para montar o link do email de
# verificação de cadastro (ex: https://seusite.vercel.app/verificar-email?token=...)
FRONTEND_URL=http://localhost:3000

# Brevo (opcional) — para newsletter/lista de contatos e para o email
# transacional de verificação de cadastro. BREVO_SENDER_EMAIL precisa ser um
# remetente verificado na sua conta Brevo (Settings > Senders & IP).
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=

# Client ID do OAuth do Google (console.cloud.google.com > APIs & Services >
# Credentials) — usado para validar o token de "Entrar com Google". Precisa
# ser o mesmo valor de NEXT_PUBLIC_GOOGLE_CLIENT_ID no frontend.
GOOGLE_CLIENT_ID=

# Usados apenas pelo script de seed para criar o primeiro admin
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# Asaas (gateway de pagamento) — usado pela assinatura paga do plano Premium
# (ver server/src/config/plans.js). Enquanto ASAAS_API_KEY não estiver
# definida, o botão "Assinar" no site mostra um aviso de "em breve" e nenhuma
# chamada é feita (mesmo padrão de recurso dormente do BREVO_API_KEY acima).
# Chave de sandbox começa com $aact_hmlg_, produção com $aact_prod_.
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token de autenticação de webhook (Asaas > Integrações > Webhooks) — validado
# no header asaas-access-token de cada notificação recebida em /api/billing/webhook.
ASAAS_WEBHOOK_TOKEN=

# Segredo compartilhado com o frontend (mesmo valor de REVALIDATE_SECRET lá)
# — usado só entre os dois servidores, nunca pelo navegador. Sem isso, editar
# um filme no admin ainda funciona, só demora até 5 min pra aparecer no site
# (revalidate: 300 nas rotas públicas) em vez de refletir na hora.
REVALIDATE_SECRET=
