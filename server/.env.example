# MongoDB Atlas — connection string do cluster free tier
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.mongodb.net/sva-stream

# Porta local (Render define isso sozinho em produção)
PORT=4000

# Segredo para assinar os tokens JWT do admin — gere algo aleatório e longo
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Domínios que podem chamar a API (separe por vírgula). Use * apenas em dev.
CORS_ORIGIN=http://localhost:3000

# Brevo (opcional) — para newsletter/lista de contatos
BREVO_API_KEY=
BREVO_LIST_ID=

# Usados apenas pelo script de seed para criar o primeiro admin
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=troque-esta-senha
